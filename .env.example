TESLA_CLIENT_ID=your-client-id
TESLA_CLIENT_SECRET=your-client-secret
TESLA_REDIRECT_URI=http://localhost:8085/callback

# Notification credentials (optional). Keep real values in .env only; never
# commit them. Select the service in config.toml with notify.service.
# ntfy: the topic acts as a password on public ntfy.sh.
TESLA_NTFY_TOPIC=
TESLA_NTFY_TOKEN=
TESLA_NTFY_URL=
# Pushover: register an application to get an API token, then copy your
# user/group key from https://pushover.net/dashboard.
TESLA_PUSHOVER_TOKEN=
TESLA_PUSHOVER_USER=
TESLA_PUSHOVER_URL=
